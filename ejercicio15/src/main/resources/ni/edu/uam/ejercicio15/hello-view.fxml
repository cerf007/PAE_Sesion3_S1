<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio15.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Cola de Impresión"/>

    <TextField fx:id="txtNombreDoc" promptText="Nombre del documento" />
    <TextField fx:id="txtPaginas" promptText="Número de páginas" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Agregar Documento" onAction="#onAgregarClick"/>
        <Button text="Imprimir Documento" onAction="#onImprimirClick"/>
        <Button text="Mostrar Siguiente" onAction="#onMostrarSiguienteClick"/>
    </HBox>

    <Label fx:id="lblDocumentoImprimiendo" text="Imprimiendo: Ninguno"/>
    <Label fx:id="lblSiguiente" text="Siguiente a imprimir: Ninguno"/>
    <Label fx:id="lblPendientes" text="Documentos pendientes: 0"/>

    <Label text="Documentos en Cola:"/>
    <Label fx:id="lblListaPendientes" text="No hay documentos pendientes de impresión." wrapText="true"/>

    <Label fx:id="lblMensaje" text=""/>
</VBox>
