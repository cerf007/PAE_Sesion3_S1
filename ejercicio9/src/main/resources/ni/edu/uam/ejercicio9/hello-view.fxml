<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="ni.edu.uam.ejercicio9.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblTittle" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Pila de Números (LIFO)" textFill="#eb3333" />

    <TextField fx:id="txtNumero" promptText="Ingrese un número" />

    <HBox alignment="CENTER" spacing="8.0">
        <Button onAction="#onPushClick" text="Push (Apilar)" />
        <Button onAction="#onPopClick" text="Pop (Desapilar)" />
        <Button onAction="#onPeekClick" text="Peek (Ver Tope)" />
        <Button onAction="#onEstaVaciaClick" text="¿Está Vacía?" />
    </HBox>

    <Label text="Estado de la Pila:" />
    <Label fx:id="lblPila" text="La pila está vacía." wrapText="true" />

    <Label fx:id="lblMensaje" text="" />
</VBox>
