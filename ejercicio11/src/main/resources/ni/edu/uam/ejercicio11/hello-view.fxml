<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio11.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Verificador de Paréntesis"/>

    <TextField fx:id="txtExpresion" promptText="Ejemplo: ((18+5)*2)" />

    <Button text="Verificar Balanceo" onAction="#onVerificarClick"/>

    <Label fx:id="lblResultado" text=""/>
    <Label fx:id="lblMensaje" text="" />
</VBox>
