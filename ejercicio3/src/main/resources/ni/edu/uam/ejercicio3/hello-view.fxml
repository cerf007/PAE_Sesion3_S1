<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="440.0" prefWidth="307.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.ejercicio3.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label fx:id="lblTittle" text="Ordenamiento de Numeros" textFill="#3b38f5">
      <font>
         <Font name="System Bold" size="18.0" />
      </font>
   </Label>
   <TextField fx:id="txtTamano" onAction="#onSetTamanoClick" />
    <Button fx:id="btnSetSize" onAction="#onSetTamanoClick" text="Definir Tamaño" />
   <TextField fx:id="txtNumber" onAction="#onAddClick" />
   <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onAddClick" text="Agregar" />
   <Button fx:id="btnReset" mnemonicParsing="false" onAction="#onResetClick" text="Reset" />
   <Label fx:id="lblOriginal" />
   <Label fx:id="lblOrdenado" />
   <Label fx:id="lblMensaje" />
</VBox>
