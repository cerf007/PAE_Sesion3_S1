<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio14.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Sistema de Turnos"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Generar Turno" onAction="#onGenerarTurnoClick"/>
        <Button text="Llamar Turno" onAction="#onLlamarTurnoClick"/>
        <Button text="Mostrar Siguiente" onAction="#onMostrarSiguienteClick"/>
    </HBox>

    <Label fx:id="lblTurnoLlamado" text="Turno en atención: Ninguno"/>
    <Label fx:id="lblSiguiente" text="Siguiente en fila: Ninguno"/>
    <Label fx:id="lblPendientes" text="Clientes pendientes: 0"/>

    <Label text="Turnos en Espera:"/>
    <Label fx:id="lblListaPendientes" text="No hay clientes pendientes en fila." wrapText="true"/>

    <Label fx:id="lblMensaje" text=""/>
</VBox>
