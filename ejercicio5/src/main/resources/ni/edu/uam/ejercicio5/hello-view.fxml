<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio5.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="lblTittle" text="Lista de Estudiantes"/>
    <TextField fx:id="txtNombre"  promptText="Nombre"/>
    <TextField fx:id="txtCif"  promptText="CIF"/>
    <TextField fx:id="txtAnio"  promptText="Año cursando"/>
    <TextField fx:id="txtCarrera"  onAction="#onAgregarClick" promptText="Carrera"/>
    <Button fx:id="btnAdd" text="Agregar" onAction="#onAgregarClick"/>

    <TextField fx:id="txtBuscarCif" onAction="#onBuscarClick"/>
    <Button fx:id="btnSearch" text="Buscar" onAction="#onBuscarClick"/>
    <Button fx:id="btnDelete" text="Eliminar" onAction="#onEliminarClick"/>

    <Label fx:id="lblCantidad" text=""/>
    <Label fx:id="lblResultadoBusqueda" text=""/>
    <Label fx:id="lblListaCompleta" text=""/>
    <Label fx:id="lblMensaje" text=""/>

</VBox>
