<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio7.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="lblTittle" text="Gestión de Inventario"/>

    <TextField fx:id="txtNombre" promptText="Nombre del producto" />
    <TextField fx:id="txtPrecio" promptText="Precio" />
    <TextField fx:id="txtInventarioActual" promptText="Inventario Actual"/>
    <TextField fx:id="txtInventarioMinimo" promptText="Inventario Mínimo" />

    <Button fx:id="btnAgregar" text="Agregar Producto" onAction="#onAgregarClick"/>

    <TextField fx:id="txtBuscar" promptText="Nombre del producto a buscar/modificar/eliminar"/>

    <Button fx:id="btnBuscar" text="Buscar" onAction="#onBuscarClick"/>
    <Button fx:id="btnModificar" text="Modificar Datos" onAction="#onModificarClick"/>
    <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminarClick"/>

    <Label fx:id="lblResultadoBusqueda" text=""/>
    <Label fx:id="lblValorTotal" text="Valor Total del Inventario: 0.00"/>
    <Label fx:id="lblListaCompleta" text=""/>
    <Label fx:id="lblMensaje" text=""/>

</VBox>
