<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio13.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Atención de Clientes"/>

    <TextField fx:id="txtNombre" promptText="Nombre del cliente" />

    <HBox alignment="CENTER" spacing="8.0">
        <Button text="Agregar Cliente" onAction="#onAgregarClick"/>
        <Button text="Atender Cliente" onAction="#onAtenderClick"/>
        <Button text="Mostrar Siguiente" onAction="#onMostrarSiguienteClick"/>
    </HBox>

    <Label fx:id="lblCantidad" text="Clientes en espera: 0"/>
    <Label fx:id="lblSiguiente" text="Siguiente en ser atendido: Ninguno"/>

    <Label text="Cola de Espera:"/>
    <Label fx:id="lblCola" text="La cola está vacía." wrapText="true"/>

    <Label fx:id="lblMensaje" text=""/>
</VBox>
