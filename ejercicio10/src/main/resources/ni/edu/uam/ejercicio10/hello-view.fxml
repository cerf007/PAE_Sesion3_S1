<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio10.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Sistema Deshacer" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtAccion" promptText="Descripción de la acción (Ej: Escribir texto)" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Realizar Operación" onAction="#onRealizarClick"/>
        <Button text="Deshacer" onAction="#onDeshacerClick"/>
    </HBox>

    <Label fx:id="lblOperacionActual" text="Operación Actual: Ninguna (Sin operaciones)"/>

    <Label text="Pila de Operaciones:"/>
    <Label fx:id="lblHistorial" text="No hay operaciones registradas." wrapText="true"/>

    <Label fx:id="lblMensaje" text=""/>
</VBox>
