<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="434.0" prefWidth="263.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="ni.edu.uam.ejercicio4.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="txtTittle" text="Estadisticas de Notas" textFill="#3e20ff">
      <font>
         <Font name="System Bold" size="18.0" />
      </font></Label>
   <TextField fx:id="txtTamano" onAction="#onSetTamanoClick" />
    <Button fx:id="btnSetSize" onAction="#onSetTamanoClick" text="Definir Cantidad" />
   <TextField fx:id="txtNota" onAction="#onAddClick" />
   <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onAddClick" text="Agregar Nota" />
   <Button fx:id="btnReset" mnemonicParsing="false" onAction="#onResetClick" text="Reset" />
   <Label fx:id="lblNotas" />
   <Label fx:id="lblPromedio" />
   <Label fx:id="lblNotaMayor" />
   <Label fx:id="lblNotaMenor" />
   <Label fx:id="lblAprobados" />
   <Label fx:id="lblReprobados" />
   <Label fx:id="lblMensaje" />
</VBox>
