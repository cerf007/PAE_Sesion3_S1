<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.ejercicio16.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Sistema de Ventas"/>

    <TextField fx:id="txtProducto" promptText="Nombre del producto" />
    <TextField fx:id="txtPrecio" promptText="Precio unitario ($)" />
    <TextField fx:id="txtCantidad" promptText="Cantidad" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Agregar Producto" onAction="#onAgregarClick"/>
        <Button text="Nueva Venta" onAction="#onNuevaVentaClick"/>
    </HBox>

    <Label text="Detalle de la Compra:"/>
    <Label fx:id="lblDetalle" text="No hay productos registrados en la venta." wrapText="true"/>

    <TextField fx:id="txtDescuento" promptText="Descuento (%) - Opcional" text="0"/>

    <VBox alignment="CENTER_LEFT" spacing="4.0">
        <Label fx:id="lblSubtotal" text="Subtotal: $0.00"/>
        <Label fx:id="lblMontoDescuento" text="Descuento: $0.00"/>
        <Label fx:id="lblIVA" text="IVA (15%): $0.00"/>
        <Label fx:id="lblTotal" text="Total: $0.00"/>
    </VBox>

    <Label fx:id="lblMensaje"/>

</VBox>
